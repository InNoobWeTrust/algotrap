# Ticker configs (JSON array — each has symbol, sl_percent, tol_percent, default_tf)
# Note: legacy fields tfs/ntfy_tf_exclusion are still accepted but ignored.
TICKERS='[{"symbol":"BTC-USDT","sl_percent":0.1,"tol_percent":0.618,"default_tf":"4h"},{"symbol":"ETH-USDT","sl_percent":0.1,"tol_percent":0.618,"default_tf":"4h"},{"symbol":"SOL-USDT","sl_percent":0.1,"tol_percent":0.618,"default_tf":"4h"},{"symbol":"BNB-USDT","sl_percent":0.02,"tol_percent":0.01,"default_tf":"4h"},{"symbol":"XAUT-USDT","sl_percent":0.1,"tol_percent":0.618,"default_tf":"4h"},{"symbol":"NCCOGOLD2USD-USDT","sl_percent":0.02,"tol_percent":0.01,"default_tf":"4h"},{"symbol":"NCCO724OILWTI2USD-USDT","sl_percent":0.02,"tol_percent":0.01,"default_tf":"4h"}]'

# Chart timeframes (shared — all tickers get chart data for these TFs)
CHART_TFS=5m,15m,30m,1h,2h,4h,6h,8h,12h,1d,3d,1w,1M

# Scan interval (seconds) — only used when running with --loop flag
SCAN_INTERVAL_SECS=900

# Timeouts
TIMEOUT_SECS=10

# ─── CI / GitHub Actions Secrets ─────────────────────────────────────────────
# The following are NOT used by the binary itself. They are consumed by the
# GH Actions cryptobot-data.yml workflow to upload output/ to Cloudflare R2.
#
# Set them in GitHub with:
#   gh secret set CLOUDFLARE_ACCOUNT_ID
#   gh secret set CLOUDFLARE_API_TOKEN     # needs R2 write permission
#   gh secret set CLOUDFLARE_R2_BUCKET     # e.g. algotrap-cryptobot
#   gh secret set CRYPTOBOT_TICKERS        # same as TICKERS above
#   gh secret set CRYPTOBOT_CHART_TFS      # same as CHART_TFS above
