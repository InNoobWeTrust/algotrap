# Ticker configs (JSON array — each has symbol, sl_percent, tol_percent, tfs, default_tf, ntfy_tf_exclusion)
TICKERS='[{"symbol":"BTC-USDT","sl_percent":0.1,"tol_percent":0.618,"tfs":"15m,1h,4h,1d","default_tf":"4h","ntfy_tf_exclusion":"1m,1d,1w,1M"},{"symbol":"ETH-USDT","sl_percent":0.1,"tol_percent":0.618,"tfs":"15m,1h,4h,1d","default_tf":"4h","ntfy_tf_exclusion":"1m,1d,1w,1M"},{"symbol":"SOL-USDT","sl_percent":0.1,"tol_percent":0.618,"tfs":"15m,1h,4h,1d","default_tf":"4h","ntfy_tf_exclusion":"1m,1d,1w,1M"},{"symbol":"BNB-USDT","sl_percent":0.02,"tol_percent":0.01,"tfs":"15m,1h,4h,1d","default_tf":"4h","ntfy_tf_exclusion":""},{"symbol":"XAUT-USDT","sl_percent":0.1,"tol_percent":0.618,"tfs":"15m,1h,4h,1d","default_tf":"4h","ntfy_tf_exclusion":"1m,5m,1d,1w,1M"},{"symbol":"NCCOGOLD2USD-USDT","sl_percent":0.02,"tol_percent":0.01,"tfs":"15m,1h,4h,1d","default_tf":"4h","ntfy_tf_exclusion":""},{"symbol":"NCCO724OILWTI2USD-USDT","sl_percent":0.02,"tol_percent":0.01,"tfs":"15m,1h,4h,1d","default_tf":"4h","ntfy_tf_exclusion":""}]'

# Chart timeframes (shared — all tickers get chart data for these TFs)
CHART_TFS=5m,15m,30m,1h,2h,4h,6h,8h,12h,1d,3d,1w,1M

# Scan interval (seconds)
SCAN_INTERVAL_SECS=900

# Cloudflare Credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare Pages Project Name (single deployment for all tickers)
CLOUDFLARE_PAGES_PROJECT_NAME=innoobwetrust-cryptobot

# NTFY topic (each ticker sends separate notifications)
NTFY_TOPIC=
NTFY_ALWAYS=false

# Timeouts
TIMEOUT_SECS=10
