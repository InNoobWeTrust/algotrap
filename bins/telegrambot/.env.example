# ─── Trading Config ───────────────────────────────────────────────────────────
# Symbol to analyze
SYMBOL=BTC-USDT
# Stop-loss percentage (decimal)
SL_PERCENT=0.1
# ATR tolerance adjustment (decimal)
TOL_PERCENT=0.618
# Timeframes to analyze (comma-separated)
TFS=5m,15m,1h,4h,1d,1w
# Default timeframe for chart
DEFAULT_TF=4h

# ─── Telegram Config ─────────────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID to send analysis to (use @userinfobot to find yours)
TELEGRAM_CHAT_ID=

# ─── LLM Config ──────────────────────────────────────────────────────────────
# OpenAI-compatible API base URL
# In-cluster: http://litellm.default.svc.cluster.local:4000/v1
# Local dev:  http://localhost:4000/v1
LLM_API_BASE=http://localhost:4000/v1
# API key for the LLM provider
LLM_API_KEY=
# Model name
LLM_MODEL=gpt-5-mini

# ─── Browserless Config ──────────────────────────────────────────────────────
# Browserless service URL (self-hosted)
BROWSERLESS_URL=http://localhost:3000

# ─── Scheduling ──────────────────────────────────────────────────────────────
# How often to run analysis (seconds, default: 3600 = 1 hour)
ANALYSIS_INTERVAL_SECS=3600
# HTTP request timeout (seconds)
TIMEOUT_SECS=30
