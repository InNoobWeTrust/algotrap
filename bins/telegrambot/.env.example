# ─── Telegram Bot Config ─────────────────────────────────────────────────────

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# ─── Multi-Ticker Config (JSON array) ──────────────────────────────────────

# Each ticker has: symbol, sl_percent, tol_percent, tfs (comma-sep), default_tf
TICKERS=[{"symbol":"BTC-USDT","sl_percent":0.1,"tol_percent":0.618,"tfs":"1m,5m,15m,1h,4h,1d,1w,1M","default_tf":"15m"},{"symbol":"ETH-USDT","sl_percent":0.1,"tol_percent":0.618,"tfs":"1m,5m,15m,1h,4h,1d,1w,1M","default_tf":"15m"},{"symbol":"SOL-USDT","sl_percent":0.1,"tol_percent":0.618,"tfs":"1m,5m,15m,1h,4h,1d,1w,1M","default_tf":"15m"},{"symbol":"XAUT-USDT","sl_percent":0.1,"tol_percent":0.618,"tfs":"1m,5m,15m,1h,4h,1d,1w,1M","default_tf":"15m"}]

# ─── Alert Scanning ──────────────────────────────────────────────────────────

# Scan interval in seconds (default: 900 = 15 minutes)
SCAN_INTERVAL_SECS=900

# Minimum confidence (0-100) to trigger an alert (default: 70)
CONFIDENCE_THRESHOLD=70

# ─── LLM ─────────────────────────────────────────────────────────────────────

LLM_API_BASE=http://litellm.local/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model

# ─── Browserless (chart screenshot capture) ──────────────────────────────────

BROWSERLESS_URL=http://browserless.local

# ─── Prompt Config ───────────────────────────────────────────────────────────

# Directory containing prompt templates (system.txt, user.txt, tools.json,
# system_alert.txt, user_alert.txt)
PROMPTS_DIR=config/prompts

# ─── Misc ────────────────────────────────────────────────────────────────────

TIMEOUT_SECS=30
